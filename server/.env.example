# Copy to server/.env. Every value is optional; these are the defaults.

# "production" makes the server serve the built web client (client/dist) on the same port
# and stop allowing the Vite dev origin. Leave unset for local development.
# NODE_ENV=production

PORT=3001

# Extra browser origins allowed to call the API/socket, comma-separated. Only needed when the
# web client is hosted on a different domain than this server. Development default: the Vite
# dev server. Production default: none (same origin).
# CLIENT_ORIGIN=http://localhost:5173

# Reverse proxies to trust for client IPs (used by login rate limiting): "loopback" (default),
# a hop count like 1 when behind nginx/Caddy/a cloud load balancer, true, or false.
# TRUST_PROXY=loopback

# Phase durations in seconds
ACTIVE_SECONDS=90
REVEAL_SECONDS=10
LEADERBOARD_SECONDS=15

# Path to the word list (one word per line; hunspell "word/FLAGS" lines are accepted)
DICTIONARY_PATH=./data/words-hr.txt

# Game data (accounts, levels, coins, inventory, friends, messages), stored as a JSON file,
# and uploaded profile pictures. Put both on persistent storage in production.
DATA_PATH=./data/db.json
AVATAR_DIR=./data/avatars

# Built web client served in production (relative to the server folder)
# CLIENT_DIST=../client/dist
